{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": [
    "supabase/functions/**/*.ts",
    "supabase/functions/**/*.d.ts",
    "src/types/database.ts",
    "src/lib/validators/**/*.ts"
  ]
}